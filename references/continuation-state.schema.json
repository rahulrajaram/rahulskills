{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rahulskills.local/references/continuation-state.schema.json",
  "title": "Continuation State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "state_id", "campaign_id", "epoch", "source_run_id", "repository_identity", "source_commit", "predecessor_state_id", "objective_digest", "module_digest", "bundle_digest", "policy_digest", "owner", "authority", "delegation", "budget", "next_action", "status", "evidence_refs", "created_at", "updated_at"],
  "properties": {
    "schema": {"type": "integer", "const": 1},
    "state_id": {"$ref": "#/$defs/digest"}, "campaign_id": {"type": "string", "minLength": 1}, "epoch": {"type": "integer", "minimum": 0},
    "source_run_id": {"type": "string", "minLength": 1, "description": "Exact controller run_id of the completed source checkpoint, not a consumer logical label."}, "repository_identity": {"type": "string", "minLength": 1}, "source_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}, "predecessor_state_id": {"$ref": "#/$defs/digest", "description": "Exact state_id of the previously consumed continuation state; use the zero digest only at the explicitly bound genesis."},
    "objective_digest": {"$ref": "#/$defs/digest"}, "module_digest": {"$ref": "#/$defs/digest", "description": "Admitted canonical module_digest from the source run controller binding; not a raw file hash or the next module identity."}, "bundle_digest": {"$ref": "#/$defs/digest", "description": "Admitted bundle_id from the source run controller binding; not a raw bundle file hash or the next bundle."}, "policy_digest": {"$ref": "#/$defs/digest"},
    "owner": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1}}}, "authority": {"type": "object", "minProperties": 1},
    "delegation": {"type": "object", "additionalProperties": false, "required": ["grant_id", "decision_class"], "properties": {"grant_id": {"$ref": "#/$defs/digest"}, "decision_class": {"const": "same-envelope-continuation"}}},
    "budget": {"$ref": "#/$defs/budget"}, "next_action": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/action"}]},
    "status": {"type": "object", "additionalProperties": false, "required": ["phase", "terminal"], "properties": {"phase": {"enum": ["issued", "running", "checkpointed", "renewing", "completed", "stopped", "blocked", "unknown"]}, "terminal": {"type": "boolean"}, "reason": {"type": "string"}}},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time", "description": "Observed UTC time of this checkpoint update; must not be later than the actual as-of assessment time."}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "budget": {"type": "object", "additionalProperties": false, "required": ["batch_limit", "consumed", "remaining", "total_consumed", "total_ceiling"], "properties": {"batch_limit": {"type": "integer", "minimum": 0}, "consumed": {"type": "integer", "minimum": 0}, "remaining": {"type": "integer", "minimum": 0}, "total_consumed": {"type": "integer", "minimum": 0}, "total_ceiling": {"type": "integer", "minimum": 0}}},
    "action": {"type": "object", "additionalProperties": false, "required": ["kind", "owner", "action_digest"], "properties": {"kind": {"enum": ["run", "renew", "reconcile"]}, "owner": {"type": "string", "minLength": 1}, "action_digest": {"$ref": "#/$defs/digest"}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["campaign_id", "epoch", "source_run_id", "repository_identity", "source_commit", "objective_digest", "module_digest", "bundle_digest", "policy_digest", "action_digest", "attempt_status", "current_state_id", "evidence_refs", "budget", "predecessor_state_id"], "properties": {"campaign_id": {"type": "string"}, "epoch": {"type": "integer"}, "source_run_id": {"type": "string"}, "repository_identity": {"type": "string"}, "source_commit": {"type": "string"}, "objective_digest": {"$ref": "#/$defs/digest"}, "module_digest": {"$ref": "#/$defs/digest"}, "bundle_digest": {"$ref": "#/$defs/digest"}, "policy_digest": {"$ref": "#/$defs/digest"}, "action_digest": {"$ref": "#/$defs/digest"}, "attempt_status": {"enum": ["ready", "running", "completed", "failed", "unknown", "interrupted", "reconciled"]}, "current_state_id": {"$ref": "#/$defs/digest"}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "budget": {"$ref": "#/$defs/budget"}, "predecessor_state_id": {"$ref": "#/$defs/digest"}, "checkpoint_verified": {"type": "boolean"}, "ambiguous": {"type": "boolean"}, "concurrent": {"type": "boolean"}, "duplicate": {"type": "boolean"}, "requested_authority": {"type": "object"}, "observed_state": {"type": "string"}, "status": {"type": "string"}}},
    "grant": {"type": "object", "additionalProperties": false, "required": ["grant_id", "campaign_id", "owner", "objective_digest", "repository_identity", "policy_digest", "expires_at", "revoked", "renewal_allowed", "authority", "budget_caps", "decision_class"], "properties": {"grant_id": {"$ref": "#/$defs/digest"}, "campaign_id": {"type": "string"}, "owner": {"type": "string"}, "objective_digest": {"$ref": "#/$defs/digest"}, "repository_identity": {"type": "string"}, "policy_digest": {"$ref": "#/$defs/digest"}, "expires_at": {"type": "string", "format": "date-time"}, "revoked": {"type": "boolean"}, "renewal_allowed": {"type": "boolean"}, "authority": {"type": "object"}, "budget_caps": {"type": "object", "additionalProperties": false, "required": ["batch_limit", "total_ceiling"], "properties": {"batch_limit": {"type": "integer", "minimum": 1}, "total_ceiling": {"type": "integer", "minimum": 1}}}, "decision_class": {"const": "same-envelope-continuation"}}}
  }
}
