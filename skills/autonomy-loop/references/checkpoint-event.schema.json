{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/autonomy-loop/checkpoint-event.v1.schema.json",
  "title": "Autonomy loop checkpoint event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "sequence",
    "occurred_at",
    "epic_id",
    "task_id",
    "objective_digest",
    "authority_digest",
    "event_kind",
    "status",
    "acceptance_ids",
    "source",
    "proof_receipt",
    "budgets",
    "token_usage",
    "failure_evidence",
    "next_ready_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "autonomy.checkpoint.v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "epic_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": ["string", "null"]
    },
    "objective_digest": {
      "$ref": "#/$defs/digest"
    },
    "authority_digest": {
      "$ref": "#/$defs/digest"
    },
    "event_kind": {
      "enum": [
        "patch_completed",
        "slice_completed",
        "tranche_completed",
        "commit_created",
        "milestone_completed",
        "proof_run",
        "budget_event",
        "authority_revised",
        "context_compaction",
        "stop"
      ]
    },
    "status": {
      "enum": [
        "active",
        "checkpointed",
        "complete",
        "blocked",
        "unknown",
        "stopped"
      ]
    },
    "acceptance_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "dependency_digest",
        "toolchain",
        "feature_set_digest",
        "command_manifest_digest",
        "environment_digest",
        "frozen_artifact_digests"
      ],
      "properties": {
        "commit": {
          "type": ["string", "null"]
        },
        "tree": {
          "type": "string",
          "minLength": 1
        },
        "dependency_digest": {
          "anyOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        },
        "toolchain": {
          "type": ["string", "null"]
        },
        "feature_set_digest": {
          "anyOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        },
        "command_manifest_digest": {
          "anyOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        },
        "environment_digest": {
          "anyOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        },
        "frozen_artifact_digests": {
          "type": "array",
          "items": {"$ref": "#/$defs/digest"},
          "uniqueItems": true
        }
      }
    },
    "proof_receipt": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/proof_receipt"}
      ]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_seconds",
        "tool_seconds",
        "wait_seconds",
        "user_wait_seconds",
        "proof_groups",
        "commits",
        "failures",
        "external_cost"
      ],
      "properties": {
        "active_seconds": {"type": ["number", "null"], "minimum": 0},
        "tool_seconds": {"type": ["number", "null"], "minimum": 0},
        "wait_seconds": {"type": ["number", "null"], "minimum": 0},
        "user_wait_seconds": {"type": ["number", "null"], "minimum": 0},
        "proof_groups": {"type": "integer", "minimum": 0},
        "commits": {"type": "integer", "minimum": 0},
        "failures": {"type": "integer", "minimum": 0},
        "external_cost": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "token_usage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["fresh_input", "cached_input", "output", "reasoning"],
      "properties": {
        "fresh_input": {"type": ["integer", "null"], "minimum": 0},
        "cached_input": {"type": ["integer", "null"], "minimum": 0},
        "output": {"type": ["integer", "null"], "minimum": 0},
        "reasoning": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "failure_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/digest"},
      "uniqueItems": true
    },
    "next_ready_actions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^(?:[a-z0-9][a-z0-9+.-]*:)?[0-9a-f]{32,}$"
    },
    "proof_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "command",
        "exit_code",
        "duration_seconds",
        "identity_digest",
        "outcome",
        "reused"
      ],
      "properties": {
        "scope": {"enum": ["focused", "global"]},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exit_code": {"type": "integer"},
        "duration_seconds": {"type": "number", "minimum": 0},
        "identity_digest": {"$ref": "#/$defs/digest"},
        "outcome": {"enum": ["passed", "failed", "unknown"]},
        "reused": {"type": "boolean"}
      }
    }
  }
}
