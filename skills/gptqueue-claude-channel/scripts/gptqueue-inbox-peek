#!/usr/bin/env bash
# Non-consuming inbox check (Redis LLEN on gptq:q:<name>); never pops a message.
#   gptqueue-inbox-peek [--name N] [--dir D]            print the pending count
#   gptqueue-inbox-peek --watch [--interval S] [--timeout S]
#       poll until the inbox is non-empty, print one JSON line, exit 0.
#       Exit 3 on timeout (0 = no timeout). Suited to Claude's run_in_background.
set -euo pipefail
here="$(dirname "$(realpath "$0")")"
name="" dir="$PWD" watch=0 interval=30 timeout=0
while [ $# -gt 0 ]; do
  case "$1" in
    --name) name="$2"; shift 2 ;;
    --dir) dir="$2"; shift 2 ;;
    --watch) watch=1; shift ;;
    --interval) interval="$2"; shift 2 ;;
    --timeout) timeout="$2"; shift 2 ;;
    -h|--help) sed -n 2,7p "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done
[ -n "$name" ] || name="$("$here/gptqueue-claude-name" "$dir")"
redis_url="${REDIS_URL:-redis://127.0.0.1:6379/0}"

count() { redis-cli -u "$redis_url" --no-raw LLEN "gptq:q:$name" | tr -dc '0-9'; }

if [ "$watch" -eq 0 ]; then
  n="$(count)"; printf '%s\n' "${n:-0}"; exit 0
fi
start=$(date +%s)
while :; do
  n="$(count || true)"
  if [ "${n:-0}" -gt 0 ]; then
    printf '{"agent":"%s","pending":%s,"at":"%s"}\n' "$name" "$n" "$(date -u +%FT%TZ)"
    exit 0
  fi
  if [ "$timeout" -gt 0 ] && [ $(( $(date +%s) - start )) -ge "$timeout" ]; then
    printf '{"agent":"%s","pending":0,"timeout":true}\n' "$name"; exit 3
  fi
  sleep "$interval"
done
