%%{init: {"theme":"base","themeVariables":{"background":"transparent","primaryColor":"#ffffff","primaryBorderColor":"#111827","primaryTextColor":"#111827","lineColor":"#334155","secondaryColor":"#ffffff","tertiaryColor":"#ffffff","clusterBkg":"transparent","clusterBorder":"#111827"},"flowchart":{"htmlLabels":true,"curve":"basis","nodeSpacing":38,"rankSpacing":54}}}%%
flowchart TB
    entry(["ENTRY · a typed ObjectiveRequest value arrives"])

    subgraph Legend["Shape is category · color is status"]
        legend_function["Callable skill or function · rectangle"]
        legend_artifact[/"Immutable typed value · parallelogram"/]
        legend_runtime[["Runtime function · subroutine"]]
        legend_gate(["Human authority gate · stadium · principal decides"])
        legend_current["BLUE · currently supported"]
        legend_proposed["GREEN · proposed or missing"]
        legend_improve["ORANGE · current but needs improvement"]
    end

    subgraph Prepare["PROPOSED COMPOSITION BOUNDARY · prepareObjective"]
        request[/"PROPOSED VALUE · ObjectiveRequest<br/>requester, principal, objective, delegation proof"/]
        authorize["PROPOSED AUTHORITY FUNCTION · authorizeRequest<br/>checks the delegation proof; a requester cannot appoint itself principal"]
        frame["PROPOSED SKILL · frame-goals-constraints<br/>callable phase frameGoalsAndConstraints"]
        thesis[/"PROPOSED VALUE · ProductThesis"/]
        grill["PROPOSED SKILL · grilling<br/>callable phase grillMaterialUnknowns"]
        decisions[/"PROPOSED VALUE · DecisionRecord"/]
        ratify(["PROPOSED HUMAN AUTHORITY GATE · principalRatify<br/>the principal owns meaning, success, and reserved decisions"])
        decompose["PROPOSED SKILL · objective-to-dag-decomposition<br/>callable phase decomposeObjective"]
        dag[/"PROPOSED VALUE · ExecutionDag"/]
        envelope["PROPOSED AUTHORITY FUNCTION · deriveAttenuatedEnvelope<br/>attenuates the ratified ceiling; never widens it"]
        prepared[/"PROPOSED VALUE · PreparedObjective<br/>thesis, decisions, DAG, authority envelope"/]
    end

    subgraph Compose["Resolve a reproducible composition"]
        catalog[/"PROPOSED VALUE · ContractCatalog<br/>contracts plus execution bindings"/]
        recipe[/"PROPOSED VALUE · RecipeSpec"/]
        resolve["PROPOSED PURE FUNCTION · resolve"]
        resolved[/"PROPOSED VALUE · ResolvedGraph"/]
        create_lock["PROPOSED PURE FUNCTION · createResolutionLock"]
        lock[/"PROPOSED VALUE · ResolutionLock"/]
    end

    subgraph Build["Compile and admit using current MetaBuilder machinery"]
        compile[["CURRENT RUNTIME FUNCTION · compileHarness"]]
        bundle[/"CURRENT VALUE · content-addressed HarnessBundle"/]
        admit[["CURRENT RUNTIME FUNCTION · admitBundle"]]
        admitted[/"CURRENT VALUE · AdmittedBundle"/]
    end

    subgraph Execute["Execute, observe, verify, and qualify"]
        run[["CURRENT RUNTIME FUNCTION · runHarness"]]
        claim[/"CURRENT VALUE · worker Claim"/]
        observe[["CURRENT RUNTIME FUNCTION · controllerObserve"]]
        observation[/"CURRENT VALUE · Observation"/]
        verify["PROPOSED FUNCTION · controllerVerify"]
        record[/"PROPOSED VALUE · VerificationRecord"/]
        qualify[["CURRENT BUT IMPRECISE · qualifyOutcome"]]
        outcome[/"FinalOutcome<br/>accepted, rejected, unknown, or bounded stop"/]
    end

    exit(["EXIT · qualified result or explicit bounded stop"])

    entry -.-> request
    request -.-> authorize
    authorize -.-> frame
    frame -.-> thesis
    thesis -.-> grill
    grill -.-> decisions
    decisions -.-> ratify
    ratify -.-> decompose
    decompose -.-> dag
    dag -.-> envelope
    envelope -.-> prepared

    phase_note["PHASE RESULTS ARE CLAIMS<br/>Each callable skill phase returns a claim.<br/>The controller verifies it independently before the result flows on as evidence."]
    frame -.-> phase_note

    authority_note["AUTHORITY IS AN INPUT<br/>The authority envelope inside PreparedObjective is a ceiling.<br/>Resolution may attenuate it; no function or worker may widen it."]
    prepared -.-> authority_note
    authority_note -.-> resolve

    prepared -.-> resolve
    catalog -.-> resolve
    recipe -.-> resolve
    resolve -.-> resolved
    resolved -.-> create_lock
    create_lock -.-> lock

    lock -.-> compile
    compile --> bundle
    bundle --> admit
    admit --> admitted
    admitted --> run

    run --> claim
    claim --> claim_note["CLAIM IS NOT EVIDENCE<br/>The producer states what happened; the controller observes it independently."] --> observe
    observe --> observation
    observation -.-> verify
    verify -.-> record
    record -.-> qualify
    qualify --> outcome
    outcome --> exit

    kernel_note["FIRST-SLICE LIMIT<br/>Two deterministic bindings can prove resolution, typed transfer, denial, recovery and replay.<br/>They do not execute autonomy-loop or autonomous-execution-contract semantics."]
    resolved -.-> kernel_note

    classDef current fill:#ffffff,stroke:#1d4ed8,stroke-width:3px,color:#000000,font-weight:bold;
    classDef proposed fill:#ffffff,stroke:#16a34a,stroke-width:3px,color:#14532d,font-weight:bold;
    classDef improve fill:#ffffff,stroke:#f97316,stroke-width:3px,color:#7c2d12,font-weight:bold;
    classDef neutral fill:#ffffff,stroke:#64748b,stroke-width:1.5px,color:#000000;
    classDef relationship fill:#fef3c7,stroke:#111827,stroke-width:1.5px,color:#000000;

    class compile,bundle,admit,admitted,run,claim,observe,observation,legend_current current;
    class request,authorize,frame,thesis,grill,decisions,ratify,decompose,dag,envelope,prepared,catalog,recipe,resolve,resolved,create_lock,lock,verify,record,legend_proposed proposed;
    class qualify,legend_improve improve;
    class entry,exit,outcome,legend_function,legend_artifact,legend_runtime,legend_gate neutral;
    class phase_note,authority_note,claim_note,kernel_note relationship;

    style Legend fill:#ffffff,stroke:#111827,stroke-width:1.5px
    style Prepare fill:#ffffff,stroke:#16a34a,stroke-width:2px,stroke-dasharray:6 4
    style Compose fill:#ffffff,stroke:#16a34a,stroke-width:2px,stroke-dasharray:6 4
    style Build fill:#ffffff,stroke:#1d4ed8,stroke-width:2px
    style Execute fill:#ffffff,stroke:#94a3b8,stroke-width:1.5px
