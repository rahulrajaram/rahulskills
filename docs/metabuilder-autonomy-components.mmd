%%{init: {"theme":"base","themeVariables":{"background":"transparent","primaryColor":"#ffffff","primaryBorderColor":"#111827","primaryTextColor":"#111827","lineColor":"#334155","secondaryColor":"#ffffff","tertiaryColor":"#ffffff","clusterBkg":"transparent","clusterBorder":"#111827"},"flowchart":{"htmlLabels":true,"curve":"basis","nodeSpacing":38,"rankSpacing":54}}}%%
flowchart TB
    entry(["ENTRY · a typed ObjectiveRequest arrives"])
    overview_notice["MIXED ARCHITECTURAL OVERVIEW<br/>This inventory combines actors, skills, artifacts, proposed functions and runtime components.<br/>Use the functional, authority and runtime projections for type-specific explanations."]

    subgraph Legend["How to read this review"]
        legend_actor(["Actor shape"])
        legend_artifact[("Artifact shape")]
        legend_runtime[["Runtime component shape"]]
        legend_major["Established major component"]
        legend_minor["Established minor component"]
        legend_improve["Existing component needing improvement"]
        legend_missing["Missing or proposed component"]
        legend_relation["Relationship note: present handoff plus missing contract"]
        legend_solid["Solid path = currently declared or supported"]
        legend_dashed["Dashed path = proposed, weakly typed, or not yet supported"]
    end

    subgraph Authoring["Current human and skill-guided authoring"]
        requester(["Requester<br/>submits the objective"])
        principal(["Principal · authority owner<br/>defines success and reserved decisions"])
        frame["Product thesis<br/>frame-goals-constraints"]
        grill["Task understanding<br/>grilling"]
        charter["Operating authority model<br/>define-operating-charter"]
        dag["Typed plan<br/>objective-to-dag-decomposition"]
        guidance["Human guidance<br/>SKILL.md"]
    end

    subgraph Composition["Proposed repository-owned composition kernel"]
        contracts["PROPOSED · Phase Skill Contracts<br/>nominal ports, failures, scoped operations"]
        binding["PROPOSED · Callable Execution Binding<br/>exact adapter that implements one phase"]
        recipes["PROPOSED · RecipeSpec<br/>roles, multiplicity, completeness predicates"]
        authority["PROPOSED · AuthorityEnvelopeRef<br/>ratified ceiling that composition may only attenuate"]
        resolver["PROPOSED · Resolver and Compatibility Checker<br/>producer-to-consumer assignability"]
        lockfile["PROPOSED · ResolutionLock<br/>bindings, adapters, policy and compiler identities"]
        compose["PROPOSED · compose or update-module frontend<br/>build-time only; never mutates a live run"]
    end

    subgraph Runtime["Current MetaBuilder runtime substrate"]
        module["Harness Module v2<br/>current admitted workflow format"]
        compile["Deterministic compile and check"]
        bundle["Content-addressed bundle"]
        broker["Capability broker and effect preview"]
        runner["Static workflow runner<br/>bounded control flow"]
        attempts["Durable intent, attempt, observation<br/>and effect-outcome Unknown"]
        claims["Worker or adapter output<br/>remains a claim"]
        evidence["Current artifacts, journal,<br/>receipts, recovery and replay"]
        qualify["Consumer qualification<br/>needs clearer assurance dimensions"]
        retro["Worker and epoch retrospectives"]
    end

    subgraph Verification["Proposed trust and verification boundary"]
        approver["PROPOSED · Authenticated Approval Verifier"]
        decision["PROPOSED · Decision Attestation<br/>actor, scope, digest, expiry and revocation"]
        verification["PROPOSED · Controller VerificationRecord<br/>subject, check, adapter, observation and verifier"]
        enforcement["PROPOSED · Resource Enforcement Matrix<br/>declared, enforced, evidenced or unsupported"]
    end

    subgraph Kernel["Smallest credible first slice · composition-conformance kernel"]
        producer["PROPOSED · Deterministic task-spec producer adapter"]
        typed_artifact[("PROPOSED · Typed immutable task artifact")]
        consumer["PROPOSED · Read-only validating consumer adapter"]
        kernel_proof["PROPOSED · Kernel proof suite<br/>transfer, refusal, timeout, reconciliation and replay"]
        kernel_exit(["EXIT A · substrate qualifies or fails closed"])
    end

    subgraph Complete["Later graduation milestone · complete bounded autonomous harness"]
        agent["MISSING · Governed agent claim adapter<br/>exact route and hard limits"]
        candidate["MISSING · Isolated writable candidate<br/>never ambient target authority"]
        observe["MISSING · Controller observes patch and tests"]
        independent["MISSING · Independent review and admission"]
        integrate["MISSING · Qualified integration or local commit"]
        continue["MISSING · Finite multi-slice continuation<br/>checkpoint, recover, stop or trip breaker"]
        complete_exit(["EXIT B · objective accepted or bounded stop"])
    end

    entry --> overview_notice
    overview_notice -.-> requester
    requester --> rel_requester_principal["ACTOR DISTINCTION<br/>Requester and principal may be the same human, but remain separate fields.<br/>An agent requester needs delegation and cannot appoint itself principal."] --> principal
    principal --> rel_principal_frame["OWNS DECISION<br/>The principal ratifies meaning, success and reserved choices after the request arrives.<br/>No skill may widen this authority by composing itself."] --> frame
    principal -.-> grill
    frame --> rel_frame_dag["CONSUMES ARTIFACT · ESTABLISHED<br/>The DAG skill is an explicit planning handoff from the product thesis.<br/>A versioned thesis artifact and preservation check are still missing."] --> dag
    frame -.-> rel_frame_grill["PROPOSED HANDOFF<br/>Grilling can challenge the thesis, but no typed decision record connects them."] -.-> grill
    grill -.-> rel_grill_charter["PROPOSED HANDOFF<br/>Resolved unknowns should inform authority, but approver identity and provenance are not portable."] -.-> charter

    guidance -.-> rel_guidance_contract["PROPOSED BINDING<br/>Human guidance remains normative prose; each callable phase needs explicit instruction references,<br/>a semantic version and a concrete execution binding."] -.-> contracts
    contracts -.-> binding
    dag -.-> recipes
    charter -.-> authority
    contracts -.-> resolver
    binding -.-> resolver
    recipes -.-> resolver
    authority -.-> rel_authority_resolver["AUTHORITY CHECK<br/>Resolution may only attenuate a ratified ceiling; repository contracts are claims,<br/>never a source of authority."] -.-> resolver
    resolver -.-> rel_resolver_lock["RESOLVES THEN LOCKS<br/>Compatibility uses nominal type identity and direction-aware assignability.<br/>Digests identify the exact accepted result; they do not define compatibility."] -.-> lockfile
    lockfile -.-> compose
    compose -.-> rel_compose_module["PROPOSED ADAPTER<br/>The frontend emits a new Harness Module and requires fresh qualification.<br/>Changing an active run is a separate quiescent revision operation."] -.-> module

    module --> compile
    compile --> bundle
    bundle --> broker
    broker --> runner
    runner --> attempts
    attempts --> claims
    claims --> rel_claim_verification["EVIDENCE BOUNDARY<br/>A producer cannot label its own output controller evidence.<br/>The controller must observe and verify the claim independently."] --> evidence
    evidence --> qualify
    evidence --> retro
    qualify -.-> rel_qual_dimensions["IMPROVEMENT NEEDED<br/>Report structural integrity, execution provenance, semantic adequacy<br/>and production readiness as separate assurance dimensions."] -.-> verification
    retro -.-> principal

    approver -.-> decision
    decision -.-> authority
    verification -.-> evidence
    enforcement -.-> broker

    producer -.-> typed_artifact
    typed_artifact -.-> consumer
    producer -.-> contracts
    consumer -.-> contracts
    producer -.-> recipes
    consumer -.-> recipes
    consumer -.-> kernel_proof
    attempts -.-> kernel_proof
    verification -.-> kernel_proof
    kernel_proof -.-> rel_kernel_boundary["SCOPE LIMIT<br/>This proves contract resolution, runtime transfer, denial, recovery and replay.<br/>It does not execute autonomy-loop or autonomous-execution-contract semantics."] -.-> kernel_exit

    agent -.-> candidate
    candidate -.-> observe
    observe -.-> verification
    verification -.-> independent
    independent -.-> integrate
    integrate -.-> continue
    continue -.-> complete_exit
    agent -.-> enforcement
    decision -.-> agent
    continue -.-> principal

    classDef major fill:#ffffff,stroke:#1d4ed8,stroke-width:4px,color:#000000,font-weight:bold;
    classDef minor fill:#ffffff,stroke:#64748b,stroke-width:1.5px,color:#000000;
    classDef improveMajor fill:#ffffff,stroke:#f97316,stroke-width:4px,color:#7c2d12,font-weight:bold;
    classDef improveMinor fill:#ffffff,stroke:#f97316,stroke-width:2.5px,color:#7c2d12;
    classDef missing fill:#ffffff,stroke:#16a34a,stroke-width:3px,color:#14532d,font-weight:bold;
    classDef relationship fill:#fef3c7,stroke:#111827,stroke-width:1.5px,color:#000000;

    class entry,requester,principal,module,bundle,broker,runner,attempts,evidence,retro,legend_major major;
    class frame,grill,charter,dag,guidance,compile,claims,legend_actor,legend_artifact,legend_runtime,legend_minor minor;
    class qualify,legend_improve improveMajor;
    class contracts,binding,recipes,authority,resolver,lockfile,compose,approver,decision,verification,enforcement,producer,typed_artifact,consumer,kernel_proof,kernel_exit,agent,candidate,observe,independent,integrate,continue,complete_exit,legend_missing missing;
    class overview_notice,legend_relation,legend_solid,legend_dashed,rel_requester_principal,rel_principal_frame,rel_frame_dag,rel_frame_grill,rel_grill_charter,rel_guidance_contract,rel_authority_resolver,rel_resolver_lock,rel_compose_module,rel_claim_verification,rel_qual_dimensions,rel_kernel_boundary relationship;

    style Legend fill:#ffffff,stroke:#111827,stroke-width:1.5px
    style Authoring fill:#ffffff,stroke:#94a3b8,stroke-width:1.5px
    style Composition fill:#ffffff,stroke:#16a34a,stroke-width:2px,stroke-dasharray:6 4
    style Runtime fill:#ffffff,stroke:#1d4ed8,stroke-width:2px
    style Verification fill:#ffffff,stroke:#16a34a,stroke-width:2px,stroke-dasharray:6 4
    style Kernel fill:#ffffff,stroke:#16a34a,stroke-width:2px,stroke-dasharray:6 4
    style Complete fill:#ffffff,stroke:#16a34a,stroke-width:2px,stroke-dasharray:6 4
